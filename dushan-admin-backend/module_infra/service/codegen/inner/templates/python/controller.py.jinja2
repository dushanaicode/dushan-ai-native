{% if enable_export %}
    @staticmethod
    @{{ business_name }}_controller.get("/export-fields")
    @RoutePolicy(permissions=("{{ module_name }}:{{ business_name }}:export",),tenant_required=True,realm=SecurityRealm.TENANT)
    async def export_fields()->Result[list[dict[str,str]]]:
        return Result.success(ExcelWriter.export_fields({{ class_name }}RespVO))

    @staticmethod
    @{{ business_name }}_controller.get("/export-excel")
    @RoutePolicy(permissions=("{{ module_name }}:{{ business_name }}:export",),tenant_required=True,realm=SecurityRealm.TENANT)
    async def export(request:Request,fields:list[str]|None=Query(None),service:{{ class_name }}Service=Depends(DiDependency({{ class_name }}Service)),writer:ExcelWriter=Depends(DiDependency(ExcelWriter)),files:FileResult=Depends(DiDependency(FileResult)),pages:PageSettings=Depends(DiDependency(PageSettings)),dictionaries:DictDataProvider=Depends(DiDependency(DictDataProvider))):
{% if is_tree %}
        rows=await service.get_{{ business_name }}_list()
{% else %}
        query=RequestUtils.validate_with_auto_list_params(request,{{ class_name }}PageReqVO)
        query.enable_fetch_all(max_rows=min(pages.fetch_all_max_rows,writer.settings.max_export_rows))
        rows=(await service.get_{{ business_name }}_page(query)).items
{% endif %}
        data=await writer.write("数据",{{ class_name }}RespVO,[{{ class_name }}RespVO.model_validate(row) for row in rows],fields=fields,providers=ExcelProviders(dictionaries=dictionaries))
        return files.excel_stream(data,file_name="{{ business_name }}.xlsx")
{% endif %}
{% for sub in sub_tables %}
    @staticmethod
    @{{ business_name }}_controller.get("/{{ sub.table.business_name | replace('_','-') }}/list-by-{{ business_name | replace('_','-') }}-id")
    @RoutePolicy(permissions=("{{ module_name }}:{{ business_name }}:query",),tenant_required=True,realm=SecurityRealm.TENANT)
    async def get_{{ sub.table.business_name }}(id:SnowflakeIdInput=Query(...),service:{{ class_name }}Service=Depends(DiDependency({{ class_name }}Service)))->Result[list[dict]]:
        rows=await service.get_{{ sub.table.business_name }}_list_by_{{ business_name }}_id(id)
        return Result.success([{column.key:str(getattr(row,column.key)) if column.key=='id' or column.key.endswith('_id') else getattr(row,column.key) for column in row.__table__.columns if column.key not in {'tenant_id','deleted'}} for row in rows])
{% endfor %}
