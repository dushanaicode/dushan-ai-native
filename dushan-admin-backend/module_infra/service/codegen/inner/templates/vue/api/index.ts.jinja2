
{% if enable_export or not is_tree %}
import type { {% if enable_export %}ExportField, {% endif %}{% if not is_tree %}PageParam, PageResult{% endif %} } from '#/api/types';
{% endif %}

import { requestClient } from '#/api/request';

export namespace {{ module_name | pascal_case }}{{ class_name }}Api {
  /** {{ class_comment }}信息 */
  export type {{ class_name }} = {
    id: string;
    {% for column in list_result_columns %}
    {% if column.field_name not in ['id', 'creator', 'create_time', 'updater', 'update_time', 'deleted', 'tenant_id'] %}
    {{ column.field_name | camel_case }}{% if column.nullable %}?{% endif %}: {{ 'string' if column.field_name.endswith('_id') else 'number' if column.field_type in ['int', 'float'] else 'boolean' if column.field_type == 'bool' else 'unknown' if column.field_type == 'json' else 'string' }}{% if column.nullable %} | null{% endif %};
    {% endif %}
    {% endfor %}
    createTime: string;
  };

  export type {{ class_name }}SaveReqVO = {
    id?: string;
    {% for column in create_columns %}
    {% if column.field_name not in ['id', 'creator', 'create_time', 'updater', 'update_time', 'deleted', 'tenant_id'] %}
    {{ column.field_name | camel_case }}{% if column.nullable %}?{% endif %}: {{ 'string' if column.field_name.endswith('_id') else 'number' if column.field_type in ['int', 'float'] else 'boolean' if column.field_type == 'bool' else 'unknown' if column.field_type == 'json' else 'string' }}{% if column.nullable %} | null{% endif %};
    {% endif %}
    {% endfor %}
  };
  {% for sub in sub_tables %}
  export type {{ sub.table.class_name }} = {
    {% for column in sub.columns %}
    {% if column.field_name not in ['creator', 'updater', 'deleted', 'tenant_id'] %}
    {{ column.field_name | camel_case }}{% if column.nullable %}?{% endif %}: {{ 'string' if column.field_name == 'id' or column.field_name.endswith('_id') else 'number' if column.field_type in ['int', 'float'] else 'boolean' if column.field_type == 'bool' else 'unknown' if column.field_type == 'json' else 'string' }}{% if column.nullable %} | null{% endif %};
    {% endif %}
    {% endfor %}
  };
  {% endfor %}
}

{% if is_tree %}
/** 查询{{ class_comment }}列表 */
export function get{{ class_name }}List(params?: Record<string, unknown>) {
  return requestClient.get<{{ module_name | pascal_case }}{{ class_name }}Api.{{ class_name }}[]>('/{{ module_name }}/{{ business_name | replace('_', '-') }}/list', { params });
}

/** 查询{{ class_comment }}（精简）列表 */
export function getSimple{{ class_name }}List() {
  return requestClient.get<{{ module_name | pascal_case }}{{ class_name }}Api.{{ class_name }}[]>('/{{ module_name }}/{{ business_name | replace('_', '-') }}/simple-list');
}
{% else %}
/** 查询{{ class_comment }}分页 */
export function get{{ class_name }}Page(params: PageParam & Record<string, unknown>) {
  return requestClient.get<PageResult<{{ module_name | pascal_case }}{{ class_name }}Api.{{ class_name }}>>('/{{ module_name }}/{{ business_name | replace('_', '-') }}/page', { params, paramsSerializer: 'repeat' });
}
{% endif %}

/** 获取{{ class_comment }}详情 */
export function get{{ class_name }}(id: string) {
  return requestClient.get<{{ module_name | pascal_case }}{{ class_name }}Api.{{ class_name }}>(`/{{ module_name }}/{{ business_name | replace('_', '-') }}/get?id=${id}`);
}

/** 新增{{ class_comment }} */
export function create{{ class_name }}(data: {{ module_name | pascal_case }}{{ class_name }}Api.{{ class_name }}SaveReqVO) {
  return requestClient.post('/{{ module_name }}/{{ business_name | replace('_', '-') }}/create', data);
}

/** 修改{{ class_comment }} */
export function update{{ class_name }}(data: {{ module_name | pascal_case }}{{ class_name }}Api.{{ class_name }}SaveReqVO) {
  return requestClient.put('/{{ module_name }}/{{ business_name | replace('_', '-') }}/update', data);
}

/** 删除{{ class_comment }} */
export function delete{{ class_name }}(id: string) {
  return requestClient.delete(`/{{ module_name }}/{{ business_name | replace('_', '-') }}/delete?id=${id}`);
}

/** 批量删除{{ class_comment }} */
export function delete{{ class_name }}List(ids: string[]) {
  return requestClient.delete(
    '/{{ module_name }}/{{ business_name | replace('_', '-') }}/delete-list',
    { params: { ids }, paramsSerializer: 'repeat' },
  );
}

{% if enable_export %}
/** 导出{{ class_comment }} */
export function export{{ class_name }}(params: Record<string, unknown>, signal?: AbortSignal) {
  return requestClient.download('/{{ module_name }}/{{ business_name | replace('_', '-') }}/export-excel', { params, signal, paramsSerializer: 'repeat' });
}

/** 获取{{ class_comment }}可导出字段列表 */
export function getExport{{ class_name }}Fields() {
  return requestClient.get<ExportField[]>(
    '/{{ module_name }}/{{ business_name | replace('_', '-') }}/export-fields',
  );
}
{% endif %}

{% if is_sub %}
{% for sub in sub_tables %}
// ==================== {{ sub.table.class_comment or sub.table.table_comment }} 子表 ====================

/** 获取{{ sub.table.class_comment or sub.table.table_comment }}列表 */
export function get{{ sub.table.class_name }}ListBy{{ class_name }}Id(id: string) {
  return requestClient.get<{{ module_name | pascal_case }}{{ class_name }}Api.{{ sub.table.class_name }}[]>('/{{ module_name }}/{{ business_name | replace('_', '-') }}/{{ sub.table.business_name | replace('_', '-') }}/list-by-{{ business_name | replace('_', '-') }}-id', { params: { id } });
}
{% endfor %}
{% endif %}
