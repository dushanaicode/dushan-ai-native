START TRANSACTION;
-- {{ class_comment | replace("\n", " ") }}菜单：按当前 Native 列契约写入。
INSERT INTO system_menu(name,permission,kind,data_permission,sort,parent_id,path,icon,component,component_name,status,visible,keep_alive,always_show,creator,updater,create_time,update_time,deleted)
VALUES ('{{ class_comment | replace("'","''") }}管理','','page',0,0,{{ table.parent_menu_id or 0 }},'{{ business_name | replace('_','-') }}','ep:menu','{{ module_name }}/{{ business_name | replace('_','-') }}/index','{{ class_name }}',1,1,1,1,'','',UTC_TIMESTAMP(),UTC_TIMESTAMP(),0);
SET @parentId=LAST_INSERT_ID();
{% for action,label in [('query','查询'),('create','创建'),('update','更新'),('delete','删除'),('export','导出')] %}
INSERT INTO system_menu(name,permission,kind,data_permission,sort,parent_id,path,icon,status,visible,keep_alive,always_show,creator,updater,create_time,update_time,deleted)
VALUES ('{{ class_comment | replace("'","''") }}{{ label }}','{{ module_name }}:{{ business_name }}:{{ action }}','action',0,{{ loop.index }},@parentId,'','#',1,1,0,0,'','',UTC_TIMESTAMP(),UTC_TIMESTAMP(),0);
{% endfor %}

UPDATE system_authorization_revision SET revision=revision+1 WHERE id=1;
COMMIT;
