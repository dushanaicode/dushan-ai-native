<script lang="ts" setup>
import type { VxeTableGridOptions } from '#/adapter/vxe-table';
import type { {{ module_name | pascal_case }}{{ class_name }}Api } from '#/api/{{ module_name }}/{{ business_name | replace('_', '-') }}';

import { ref{% if is_sub %}, watch{% endif %} } from 'vue';

import { useAccess } from '@vben/access';
import { Page, useVbenModal, VbenTableAction } from '@vben/common-ui';
import { isEmpty } from '@vben/utils';

import { message{% if is_sub %}, Tabs{% endif %} } from 'ant-design-vue';

import { useVbenVxeGrid } from '#/adapter/vxe-table';
{% set api_imports = ['delete' ~ class_name, 'delete' ~ class_name ~ 'List', 'get' ~ class_name ~ ('List' if is_tree else 'Page')] %}
{% if enable_export %}
{% set api_imports = api_imports + ['export' ~ class_name, 'getExport' ~ class_name ~ 'Fields'] %}
{% endif %}
{% if is_sub %}
{% for sub in sub_tables %}
{% set _ = api_imports.append('get' ~ sub.table.class_name ~ 'ListBy' ~ class_name ~ 'Id') %}
{% endfor %}
{% endif %}
{% if api_imports | length > 3 %}
import {
  {% for name in api_imports | sort %}
  {{ name }},
  {% endfor %}
} from '#/api/{{ module_name }}/{{ business_name | replace('_', '-') }}';
{% else %}
import { {{ api_imports | sort | join(', ') }} } from '#/api/{{ module_name }}/{{ business_name | replace('_', '-') }}';
{% endif %}
{% if enable_export %}
import { useExportModal } from '#/components/export-table';
{% endif %}
import { $t } from '#/locales';

{% if is_tree %}
import { useGridColumns } from './data';
{% elif is_sub %}
import {
  useGridColumns,
  useGridFormSchema,
  {% for sub in sub_tables %}
  useSub{{ sub.table.class_name }}GridColumns,
  {% endfor %}
} from './data';
{% else %}
import { useGridColumns, useGridFormSchema } from './data';
{% endif %}
import Form from './modules/form.vue';

type Row = {{ module_name | pascal_case }}{{ class_name }}Api.{{ class_name }};

const entityLabel = {{ class_comment | jsrepr }};
const { hasAccessByCodes } = useAccess();

const [FormModal, formModalApi] = useVbenModal({
  connectedComponent: Form,
  destroyOnClose: true,
});
{% if enable_export %}

// 导出相关状态
const { ExportModal } = useExportModal();
const exportTableRef = ref();
{% endif %}

/** 刷新表格 */
function handleRefresh() {
  {% if is_tree %}
  isExpanded.value = false;
  {% endif %}
  gridApi.query();
}
{% if enable_export %}

/** 导出表格 */
async function handleExport() {
  const fields = await getExport{{ class_name }}Fields();
  {% if not is_tree %}
  const formValues = await gridApi.formApi.getValues();
  {% else %}
  const formValues = {};
  {% endif %}

  exportTableRef.value?.setData({
    exportApi: export{{ class_name }},
    columns: fields,
    fileName: `${entityLabel}.xlsx`,
    searchParams: formValues,
  });
  exportTableRef.value?.open();
}

/** 导出成功 */
function handleExportSuccess() {
  message.success($t('ui.actionMessage.operationSuccess'));
}
{% endif %}

/** 创建{{ class_comment }} */
function handleCreate() {
  formModalApi.setData({}).open();
}

/** 编辑{{ class_comment }} */
function handleEdit(row: Row) {
  formModalApi.setData(row).open();
}

/** 删除{{ class_comment }} */
async function handleDelete(row: Row) {
  const hideLoading = message.loading({
    content: $t('ui.actionMessage.deleting', [row.id]),
    key: 'action_key_msg',
  });
  try {
    await delete{{ class_name }}(row.id);
    message.success({
      content: $t('ui.actionMessage.deleteSuccess'),
      key: 'action_key_msg',
    });
    handleRefresh();
  } finally {
    hideLoading();
  }
}

/** 批量删除{{ class_comment }} */
async function handleBatchDelete() {
  const hideLoading = message.loading($t('ui.actionMessage.deleting'), 0);
  try {
    await delete{{ class_name }}List(checkedIds.value);
    checkedIds.value = [];
    message.success($t('ui.actionMessage.deleteSuccess'));
    handleRefresh();
  } finally {
    hideLoading();
  }
}

// 选中的 ID 列表
const checkedIds = ref<string[]>([]);

/** 处理复选框变化 */
function handleRowCheckboxChange({ records }: { records: Row[] }) {
  checkedIds.value = records.map((item) => item.id);
}
{% if is_tree %}

/** 切换树形展开/收缩状态 */
const isExpanded = ref(false);
const expandLoading = ref(false);
async function toggleExpand() {
  expandLoading.value = true;
  try {
    await gridApi.grid.setAllTreeExpand(!isExpanded.value);
    isExpanded.value = !isExpanded.value;
  } finally {
    expandLoading.value = false;
  }
}
{% endif %}
{% if is_sub %}

// ==================== 主子表：选中行 + 子表数据 ====================
const selectedRowId = ref<null | string>(null);
{% for sub in sub_tables %}
const sub{{ sub.table.class_name }}Label = {{ (sub.table.class_comment or sub.table.table_comment) | jsrepr }};
const sub{{ sub.table.class_name }}List = ref<{{ module_name | pascal_case }}{{ class_name }}Api.{{ sub.table.class_name }}[]>([]);
{% endfor %}

/** 主表行点击事件 */
function handleRowClick({ row }: { row: Row }) {
  selectedRowId.value = row.id;
}

/** 监听选中行变化，加载子表数据 */
watch(selectedRowId, async (newId) => {
  if (!newId) {
    {% for sub in sub_tables %}
    sub{{ sub.table.class_name }}List.value = [];
    {% endfor %}
    return;
  }
  {% for sub in sub_tables %}
  sub{{ sub.table.class_name }}List.value = await get{{ sub.table.class_name }}ListBy{{ class_name }}Id(newId);
  {% endfor %}
});
{% endif %}

const [Grid, gridApi] = useVbenVxeGrid({
  {% if not is_tree %}
  formOptions: {
    schema: useGridFormSchema(),
  },
  {% endif %}
  gridOptions: {
    columns: useGridColumns(),
    height: 'auto',
    keepSource: true,
    {% if not is_tree %}
    proxyConfig: {
      ajax: {
        query: async ({ page }, formValues) => {
          return await get{{ class_name }}Page({
            ...formValues,
            page: page.currentPage,
            pageSize: page.pageSize,
          });
        },
      },
    },
    {% else %}
    pagerConfig: {
      enabled: false,
    },
    proxyConfig: {
      ajax: {
        query: async () => {
          const items = await get{{ class_name }}List();
          return { items, total: items.length };
        },
      },
    },
    {% endif %}
    rowConfig: {
      keyField: 'id',
      isHover: true,
      {% if is_sub %}
      isCurrent: true,
      {% endif %}
    },
    toolbarConfig: {
      refresh: true,
    },
    {% if is_tree %}
    treeConfig: {
      parentField: '{{ tree_parent_column.field_name | camel_case if tree_parent_column else "parentId" }}',
      rowField: 'id',
      transform: true,
      reserve: true,
    },
    {% endif %}
  } as VxeTableGridOptions<Row>,
  gridEvents: {
    checkboxAll: handleRowCheckboxChange,
    checkboxChange: handleRowCheckboxChange,
    {% if is_sub %}
    cellClick: handleRowClick,
    {% endif %}
  },
});
{% if is_sub %}
{% for sub in sub_tables %}

/** {{ sub.table.class_comment or sub.table.table_comment }} 子表 Grid */
const [Sub{{ sub.table.class_name }}Grid, sub{{ sub.table.class_name }}GridApi] = useVbenVxeGrid({
  gridOptions: {
    columns: useSub{{ sub.table.class_name }}GridColumns(),
    height: 300,
    data: sub{{ sub.table.class_name }}List.value,
    rowConfig: {
      keyField: 'id',
      isHover: true,
    },
  } as VxeTableGridOptions<{{ module_name | pascal_case }}{{ class_name }}Api.{{ sub.table.class_name }}>,
});
watch(sub{{ sub.table.class_name }}List, (data) => {
  sub{{ sub.table.class_name }}GridApi.setGridOptions({ data });
});
{% endfor %}
{% endif %}
</script>

<template>
  <Page auto-content-height>
    <FormModal @success="handleRefresh" />
    {% if enable_export %}
    <ExportModal ref="exportTableRef" @success="handleExportSuccess" />
    {% endif %}
    <Grid>
      <template #toolbar-tools>
        <VbenTableAction
          :actions="[
            {
              text: $t('ui.actionTitle.create', [entityLabel]),
              variant: 'default',
              icon: 'lucide:plus',
              ifShow: hasAccessByCodes(['{{ module_name }}:{{ business_name }}:create']),
              onClick: handleCreate,
            },
            {% if enable_export %}
            {
              text: $t('ui.actionTitle.export'),
              variant: 'default',
              icon: 'lucide:download',
              ifShow: hasAccessByCodes(['{{ module_name }}:{{ business_name }}:export']),
              onClick: handleExport,
            },
            {% endif %}
            {
              text: $t('ui.actionTitle.deleteBatch'),
              variant: 'link',
              danger: true,
              icon: 'lucide:trash-2',
              disabled: isEmpty(checkedIds),
              ifShow: hasAccessByCodes(['{{ module_name }}:{{ business_name }}:delete']),
              popConfirm: {
                cancelText: $t('common.cancel'),
                okText: $t('common.confirm'),
                title: $t('ui.actionMessage.deleteConfirm', [
                  `${checkedIds.length}条数据`,
                ]),
                confirm: handleBatchDelete,
              },
            },
            {% if is_tree %}
            {
              text: isExpanded ? '收缩' : '展开',
              variant: 'default',
              loading: expandLoading,
              onClick: toggleExpand,
              disabled: expandLoading,
            },
            {% endif %}
          ]"
        />
      </template>
      <template #actions="{ row }">
        <VbenTableAction
          :actions="[
            {
              text: $t('common.edit'),
              variant: 'link',
              icon: 'lucide:square-pen',
              ifShow: hasAccessByCodes(['{{ module_name }}:{{ business_name }}:update']),
              onClick: handleEdit.bind(null, row),
            },
            {
              text: $t('common.delete'),
              variant: 'link',
              danger: true,
              icon: 'lucide:trash-2',
              ifShow: hasAccessByCodes(['{{ module_name }}:{{ business_name }}:delete']),
              popConfirm: {
                cancelText: $t('common.cancel'),
                okText: $t('common.confirm'),
                title: $t('ui.actionMessage.deleteConfirm', [row.id]),
                confirm: handleDelete.bind(null, row),
              },
            },
          ]"
        />
      </template>
    </Grid>
    {% if is_sub %}

    <!-- 子表区域 -->
    <Tabs v-if="selectedRowId" class="mt-4">
      {% for sub in sub_tables %}
      <Tabs.TabPane key="{{ sub.table.business_name }}" :tab="sub{{ sub.table.class_name }}Label">
        <Sub{{ sub.table.class_name }}Grid />
      </Tabs.TabPane>
      {% endfor %}
    </Tabs>
    <div v-else class="mt-4 text-center text-gray-400">
      请点击主表行查看子表数据
    </div>
    {% endif %}
  </Page>
</template>
