-- {{ class_comment }}表结构 SQL
-- ----------------------------
-- Table: {{ table_name }} ({{ table.table_comment }})
-- ----------------------------
CREATE TABLE IF NOT EXISTS `{{ table_name }}` (
{% for column in columns %}
{% if column.computed_expression %}
    `{{ column.column_name }}` {{ column | sql_type }} GENERATED ALWAYS AS ({{ column.computed_expression }}) {{ 'STORED' if column.computed_persisted else 'VIRTUAL' }},
{% elif column.primary_key %}
    `{{ column.column_name }}` BIGINT NOT NULL COMMENT '{{ column.column_comment }}',
{% elif column.field_name == 'creator' %}
    `{{ column.column_name }}` VARCHAR(64) DEFAULT '' COMMENT '{{ column.column_comment }}',
{% elif column.field_name == 'create_time' %}
    `{{ column.column_name }}` DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP COMMENT '{{ column.column_comment }}',
{% elif column.field_name == 'updater' %}
    `{{ column.column_name }}` VARCHAR(64) DEFAULT '' COMMENT '{{ column.column_comment }}',
{% elif column.field_name == 'update_time' %}
    `{{ column.column_name }}` DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP COMMENT '{{ column.column_comment }}',
{% elif column.field_name == 'deleted' %}
    `{{ column.column_name }}` TINYINT(1) NOT NULL DEFAULT 0 COMMENT '{{ column.column_comment }}',
{% else %}
    `{{ column.column_name }}` {{ column | sql_type }} {{ 'NOT NULL' if not column.nullable else 'DEFAULT NULL' }} COMMENT '{{ column.column_comment }}',
{% endif %}
{% endfor %}
    PRIMARY KEY (`{{ primary_columns[0].column_name if primary_columns else 'id' }}`)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci COMMENT='{{ table.table_comment }}';
