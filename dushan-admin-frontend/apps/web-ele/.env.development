# 端口号
VITE_PORT=5777

VITE_BASE=/

# 登录页租户选择；后端 config.models.tenant.enabled 同时关闭时使用默认租户
VITE_APP_TENANT_ENABLE=true

# 管理后台自助注册，默认关闭；还需后端 SYSTEM_USER_REGISTER_ENABLED=true
VITE_APP_REGISTER_ENABLE=false

# 第三方登录入口，默认关闭；开启后仅展示后端 starter_auth 已配置的渠道
VITE_APP_SOCIAL_LOGIN_ENABLE=false

# 第一方扫码登录；后端 qr_login.enabled 也须开启
VITE_APP_QR_LOGIN_ENABLE=true

# 手机可访问的站点源（协议、域名/IP 和端口），留空使用当前地址；本机覆盖写入 .env.development.local
VITE_APP_QR_LOGIN_ORIGIN=

# 管理接口前缀；开发代理保留 /admin-api，与后端路由及 Cookie Path 一致
VITE_GLOB_API_URL=/admin-api

# 开发代理的真实后端地址
VITE_API_PROXY_TARGET=http://127.0.0.1:48080

# 本地后端已启用 /api/ws，使用一次性票据建立实时通知连接
VITE_WEBSOCKET_ENABLED=true
VITE_WEBSOCKET_PATH=/api/ws

# 是否打开 devtools，true 为打开，false 为关闭
VITE_DEVTOOLS=false

# 是否注入全局loading
VITE_INJECT_APP_LOADING=true
