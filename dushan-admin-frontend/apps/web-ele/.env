# 应用标题
VITE_APP_TITLE=dushan-ai-native

# 应用命名空间，用于缓存、store等功能的前缀，确保隔离
VITE_APP_NAMESPACE=dushan-ai-native

# 对store进行加密的密钥，在将store持久化到localStorage时会使用该密钥进行加密
VITE_APP_STORE_SECURE_KEY=please-replace-me-with-your-own-key

# 实时接口与票据端口就绪后启用，路径保留同源 /api 前缀
VITE_WEBSOCKET_ENABLED=false
VITE_WEBSOCKET_PATH=

# 页面文档提示开关；链接统一登记在 src/services/doc-links.ts
VITE_DOC_ALERT_ENABLED=true

# 官方免费文档站地址，留空时不显示文档链接
VITE_DOC_SITE_URL=

# 知识星球源码解读跳转页地址，留空时不显示源码解读链接
VITE_DEEP_DIVE_SITE_URL=

# Umami 访问统计，三项同时留空即关闭（开源部署默认不上报）
# 仅在自己的演示站配置：脚本地址（HTTPS）、站点 UUID、逗号分隔的上报域名
VITE_UMAMI_SCRIPT_URL=
VITE_UMAMI_WEBSITE_ID=
VITE_UMAMI_DOMAINS=
