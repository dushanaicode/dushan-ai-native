# 由官方 nginx 镜像的 docker-entrypoint envsubst 机制渲染为 /etc/nginx/conf.d/default.conf，
# 在容器启动时替换其中的 ${API_UPSTREAM}；镜像的 NGINX_ENVSUBST_FILTER 只放行这一个变量名，
# 本文件出现的 $host、$http_upgrade 等 nginx 运行时变量不会被 envsubst 触碰。
# 本文件被 include 进官方主 nginx.conf 已有的 http {} 块（该块已执行过 include mime.types;），
# 因此这里的 types {} 只是在同一 http 上下文追加 mjs 映射，不会替换整份 MIME 表。

types {
  application/javascript js mjs;
}

map $http_upgrade $connection_upgrade {
  default upgrade;
  '' close;
}

server {
  listen 8080;
  server_name _;

  root /usr/share/nginx/html;
  index index.html;

  # 与 .env.production 的 VITE_COMPRESS=none 保持一致：构建期不产出 .gz 静态压缩文件，
  # 压缩改由 nginx 运行时完成，不使用 gzip_static。
  gzip on;
  gzip_vary on;
  gzip_comp_level 6;
  gzip_min_length 1024;
  gzip_proxied any;
  gzip_types
    text/plain
    text/css
    text/xml
    text/javascript
    application/javascript
    application/json
    application/xml
    image/svg+xml;

  # 上传大小上限：当前 Native 后端尚未提供具体文件上传契约，先给出一个覆盖常见图片/
  # 文档上传场景的明确值；后续出现具体上传接口且需要更大体积时再按实际需求调整。
  client_max_body_size 20m;

  location = /admin-api {
    return 308 /admin-api/;
  }

  # 管理接口保留 /admin-api 前缀，与后端路由及认证 Cookie Path 一致。
  location ^~ /admin-api/ {
    # API_UPSTREAM 只填协议+主机[:端口]，不带路径或末尾斜杠，以保留完整请求 URI。
    proxy_pass ${API_UPSTREAM};
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;

    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection $connection_upgrade;
    proxy_buffering off;
    proxy_cache off;
    proxy_read_timeout 3600s;
    proxy_send_timeout 3600s;
    proxy_redirect off;
  }

  # WebSocket 的同源 /api 通道继续剥离代理前缀（/api/ws -> 后端 /ws）。
  location = /api {
    proxy_pass ${API_UPSTREAM}/;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_redirect off;
  }

  location ^~ /api/ {
    # API_UPSTREAM 只填协议+主机[:端口]（例如 http://backend:48080），不带路径和末尾斜杠；
    # 末尾的 / 让 nginx 用它替换匹配到的 /api/ 前缀。缺失时由 05-require-api-upstream.sh 阻止启动。
    proxy_pass ${API_UPSTREAM}/;
    proxy_http_version 1.1;

    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;

    # WebSocket 升级
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection $connection_upgrade;

    # 关闭缓冲以支持 SSE 逐块下发；同一 location 也承载普通 JSON 接口，关闭缓冲对其无害。
    proxy_buffering off;
    proxy_cache off;
    proxy_read_timeout 3600s;
    proxy_send_timeout 3600s;

    # 后端错误原样返回，不回落到 index.html
    proxy_redirect off;
  }

  # index.html 与运行时配置脚本不缓存，确保发布新版本或新配置立即生效
  location = /index.html {
    add_header Cache-Control 'no-store';
  }

  location ~ ^/_app-config-.*\.js$ {
    add_header Cache-Control 'no-store';
  }

  # 带内容哈希的静态资源可长期强缓存
  location ~ ^/(js|css|jse)/ {
    add_header Cache-Control 'public, max-age=31536000, immutable';
  }

  # SPA 页面路由回退；管理接口、WebSocket 与哈希资源目录由上面的 location 处理。
  location / {
    try_files $uri $uri/ /index.html;
  }

  error_page 500 502 503 504 /50x.html;
  location = /50x.html {
    root /usr/share/nginx/html;
  }
}
